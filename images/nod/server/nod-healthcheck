#!/bin/sh
# Docker healthchecks run outside the entrypoint, so load the generated secrets
# here (as node) before calling upstream's /api/health probe.
set -eu
[ "$(id -u)" != 0 ] || exec setpriv --reuid=1000 --regid=1000 --init-groups -- "$0"
. /usr/local/lib/nod/load-secrets.sh
exec node /app/healthcheck.mjs
